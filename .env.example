# Resend (https://resend.com) API key used to email project briefs to thrivemultimedialtd@gmail.com.
# Without it, briefs are logged to the server console instead (handy in development).
RESEND_API_KEY=

# Sender address. Leave unset to use Resend's test sender, which can only deliver to the
# email the Resend account was created with. Once Thrive's domain is verified in Resend, set e.g.:
# BRIEF_FROM="Thrive website <briefs@yourdomain.com>"
BRIEF_FROM=
